# ---------------------------------------------------------------------------
# LLM  (OpenAI-compatible endpoint)
#   build + eval : Colab-Ollama via tunnel  -> https://<tunnel-host>/v1
#   local story  : laptop Ollama            -> http://localhost:11434/v1
#   fallback     : OpenRouter free variant  -> https://openrouter.ai/api/v1
# ---------------------------------------------------------------------------
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=ollama
LLM_MODEL=qwen2.5:3b-instruct-q4_K_M

# ---------------------------------------------------------------------------
# Embeddings
# ---------------------------------------------------------------------------
EMBED_MODEL=BAAI/bge-m3

# ---------------------------------------------------------------------------
# Storage  (docker-compose services)
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql+psycopg://dip:dip@localhost:5432/dip
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=documents

# ---------------------------------------------------------------------------
# Pipeline behaviour
# ---------------------------------------------------------------------------
CONFIDENCE_METHOD=logprob_min

DATA_DIR=./data
ARTIFACTS_DIR=./artifacts
CACHE_DIR=./data/cache
